[Unit]
Description=INDS monitoring API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=inds
Group=inds
WorkingDirectory=/opt/inds/current
EnvironmentFile=/etc/inds/inds.env
ExecStart=/opt/inds/current/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
TimeoutStopSec=30
StateDirectory=inds
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
