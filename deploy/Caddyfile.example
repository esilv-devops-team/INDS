# Set INDS_MANAGEMENT_HOST and INDS_MANAGEMENT_IP in Caddy's environment.
# The management IP must be assigned to the Pi and reachable by the operators.
{
    admin off
    auto_https disable_redirects
    skip_install_trust
}

{$INDS_MANAGEMENT_HOST} {
    bind {$INDS_MANAGEMENT_IP}
    tls internal
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        root * /opt/inds/current/frontend/dist
        try_files {path} /index.html
        file_server
    }
}
